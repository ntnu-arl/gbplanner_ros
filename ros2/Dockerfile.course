ARG BASE_IMAGE=gbplanner2-course-fortress:local
FROM ${BASE_IMAGE}

# Build and display dependencies used by the existing Fortress experiments.
# The fixed rendering 6.6.4 source is built separately by build_workspace.sh.
RUN apt-get -o Acquire::Retries=3 update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
       build-essential cmake pkg-config \
       libignition-rendering6-dev libogre-next-dev libglew-dev libegl-dev libgl-dev \
       libtinyxml2-dev qtbase5-dev \
       ros-humble-rviz2 ros-humble-rviz-common ros-humble-rviz-default-plugins \
       xvfb ffmpeg python3-numpy python3-matplotlib python3-yaml fonts-noto-cjk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work/gbplanner_ros2/ros2
CMD ["bash"]
