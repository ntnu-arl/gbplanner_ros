<?xml version="1.0"?>
<sdf version="1.8">
  <world name="estimated_mapping_trial">
    <physics name="physics" type="ignored">
      <max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics">
      <engine><filename>ignition-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.2 0.25 0.3 1</background></scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="flat_ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Inner wall faces are x=-2, x=8, y=-3 and y=4, height 2 m. -->
    <model name="west_wall">
      <static>true</static><pose>-2.1 0.5 1 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.2 7.4 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 7.4 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>8.1 0.5 1 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.2 7.4 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 7.4 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>3 -3.1 1 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>10.4 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.4 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="north_wall">
      <static>true</static><pose>3 4.1 1 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>10.4 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.4 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Obstacles lie outside the path's 1 m clearance corridor, including
         the SMB footprint; none is used as a localization observation. -->
    <model name="north_pillar">
      <static>true</static><pose>0.4 2.5 0.75 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.5</size></box></geometry>
          <material><ambient>0.6 0.3 0.2 1</ambient><diffuse>0.6 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="southeast_pillar">
      <static>true</static><pose>5.9 -1.6 0.65 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.8 0.8 1.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 1.3</size></box></geometry>
          <material><ambient>0.3 0.5 0.4 1</ambient><diffuse>0.3 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="northeast_pillar">
      <static>true</static><pose>6.7 2.5 0.9 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.8</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
