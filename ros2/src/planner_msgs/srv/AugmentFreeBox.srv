# The center and axis-aligned box size are expressed in header.frame_id, which
# must equal the mapper frame. The explicit stamp identifies the requested pose.
std_msgs/Header header
geometry_msgs/Point center
geometry_msgs/Vector3 size
# Return the exact committed map in this response. Root planning can consume it
# without blocking on a map subscription in its own callback group.
bool return_snapshot
---
bool success
string reason
uint64 changed_voxels
# All three identify the committed snapshot, even without return_snapshot.
string source_id
uint64 map_epoch
uint64 update_id
# Populated only after a successful request with return_snapshot=true.
planner_msgs/VoxelMapUpdate snapshot
