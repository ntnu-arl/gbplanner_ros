  "upstream_semantics": {
    "score": "sum(viewpoint_gain_i * exp(-path_length_penalty * shortest_distance_i)) * exp(-path_direction_penalty * normalized_DTW)",
    "dtw_discrete_length_m": 0.2,
    "normalization": "square of interpolated path length",
    "reference": "n=floor(interpolated_path_length/discrete_length); repeat p0 + n*discrete_length*[cos(heading),sin(heading),0] exactly n times",
    "preserved_anomaly": "The original reference loop uses *n, not *i. It produces repeated endpoint coordinates, not a sampled forward line.",
    "direction_initial_radians": 0.0,
    "timer_period_s": 0.25,
    "direction_min_horizontal_displacement_m": 0.75,
    "direction_update": "wrap(previous + 0.7*wrap(atan2(dy,dx)-previous))",
    "history_capacity": 10,
    "history_use": "delta from the latest accepted sample; not a fit over all ten positions",
    "default_path_direction_penalty": 0.0
  },
  "native_adaptations": [
    "Eigen-only PathType and existing standalone DTW helper in gbplanner2; ROS geometry overloads are not needed.",
    "ROS 2 wall timer samples validated measured odometry. The estimate persists across local graph rebuilds and map replacement.",
    "Current-root and plan-ahead root planning use the same measured direction snapshot; a hypothetical planning root does not update motion history.",
    "A zero direction penalty leaves path selection unchanged and computes the selected path direction distance only for diagnostics.",
    "Nonfinite direction and discretization inputs are rejected by the native helper.",
    "Read-only Trigger diagnostics and planning metrics expose direction state and scoring terms."
  ],
  "scope": "Local aerial path scoring and measured exploration-direction estimate. Does not claim all Rrg timer duties, ground-robot inclination/hanging penalties, or a complete upstream Rrg port.",
  "evidence": "Implementation provenance only. Runtime and source-snapshot evidence belongs in results/direction after the experiment completes.",
  "original_files_modified": false
}
