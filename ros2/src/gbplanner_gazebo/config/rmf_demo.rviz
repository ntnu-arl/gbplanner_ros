# No dock widgets are instantiated for the recorded 1280 x 720 view.
Panels: []
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 245; 247; 250
    Fixed Frame: map
    Frame Rate: 12
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
    Color: 180; 185; 190
  - Class: rviz_default_plugins/MarkerArray
    Name: Occupancy
    Enabled: false
    Topic:
      Value: /vis/voxel_map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  # Display the mapper's actual surface points instead of opaque full-height cubes.
  - Class: rviz_default_plugins/PointCloud2
    Name: Observed surface
    Enabled: true
    Alpha: 0.85
    Color: 80; 105; 130
    Color Transformer: AxisColor
    Axis: Z
    Invert Rainbow: false
    Min Color: 20; 80; 220
    Max Color: 230; 70; 30
    Decay Time: 0
    Position Transformer: XYZ
    Size (Pixels): 3
    Style: Points
    Topic:
      Value: /surface_pointcloud
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Global graph
    Enabled: false
    Topic:
      Value: /vis/planning_global_graph
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/RobotModel
    Name: Native robot model
    Enabled: true
    Alpha: 1
    Collision Enabled: false
    Visual Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Robot and actual trace
    Enabled: true
    Topic:
      Value: /vis/robot_state
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Local candidate
    Enabled: true
    Alpha: 0.45
    Color: 30; 110; 195
    Line Style: Billboards
    Line Width: 0.03
    Topic:
      Value: /local_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Global or homing candidate
    Enabled: true
    Alpha: 0.65
    Color: 45; 150; 75
    Line Style: Billboards
    Line Width: 0.05
    Topic:
      Value: /global_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Current command
    Enabled: true
    Alpha: 1
    Color: 210; 55; 35
    Line Style: Billboards
    Line Width: 0.07
    Topic:
      Value: /command_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Timed execution path
    Enabled: false
    Color: 160; 45; 180
    Line Style: Billboards
    Line Width: 0.04
    Topic:
      Value: /execution_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link
      Distance: 12.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.3
      Pitch: 0.9
      Yaw: 0.5
      Name: Current View
Window Geometry:
  Width: 1280
  Height: 720
  X: 0
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
