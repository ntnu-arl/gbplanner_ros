# The surface cloud, robot model and traces below all come from live ROS topics.
Panels: []
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 245; 247; 250
    Fixed Frame: map
    Frame Rate: 12
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 25
    Color: 190; 195; 200
  - Class: rviz_default_plugins/PointCloud2
    Name: Observed mine surface
    Enabled: true
    Alpha: 0.85
    Color: 80; 105; 130
    Color Transformer: AxisColor
    Axis: Z
    Invert Rainbow: false
    Min Color: 20; 80; 220
    Max Color: 230; 70; 30
    Position Transformer: XYZ
    Size (Pixels): 3
    Style: Points
    Decay Time: 0
    Topic:
      Value: /surface_pointcloud
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/RobotModel
    Name: SMB with original dual lidar
    Enabled: true
    Alpha: 1
    Collision Enabled: false
    Visual Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Measured trajectory
    Enabled: true
    Topic:
      Value: /vis/robot_state
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Local candidate
    Enabled: true
    Alpha: 0.5
    Color: 30; 110; 195
    Line Style: Billboards
    Line Width: 0.035
    Topic:
      Value: /local_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Global or homing candidate
    Enabled: true
    Alpha: 0.7
    Color: 45; 150; 75
    Line Style: Billboards
    Line Width: 0.045
    Topic:
      Value: /global_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Homing graph route
    Enabled: true
    Topic:
      Value: /vis/homing_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Current command
    Enabled: true
    Alpha: 1
    Color: 210; 55; 35
    Line Style: Billboards
    Line Width: 0.055
    Topic:
      Value: /command_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: map
      Distance: 16.0
      Focal Point:
        X: -1.0
        Y: 2.5
        Z: 0.5
      Pitch: 1.0
      Yaw: 0.5
      Name: Mine exploration
Window Geometry:
  Width: 1280
  Height: 720
  X: 0
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
