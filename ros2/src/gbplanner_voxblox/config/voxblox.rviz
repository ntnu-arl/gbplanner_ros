Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 245; 247; 250
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 180; 185; 190
    - Class: rviz_default_plugins/MarkerArray
      Name: Occupancy
      Enabled: true
      Topic:
        Value: /vis/voxel_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Local graph
      Enabled: true
      Topic:
        Value: /vis/planning_graph
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Global graph
      Enabled: true
      Topic:
        Value: /vis/planning_global_graph
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot and actual trace
      Enabled: true
      Topic:
        Value: /vis/robot_state
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Local candidate
      Enabled: true
      Color: 30; 110; 195
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /local_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Global or homing candidate
      Enabled: true
      Color: 45; 150; 75
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Value: /global_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Current command
      Enabled: true
      Color: 210; 55; 35
      Line Style: Lines
      Line Width: 0.07
      Topic:
        Value: /command_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Timed execution path
      Enabled: true
      Color: 160; 45; 180
      Line Style: Lines
      Line Width: 0.04
      Topic:
        Value: /execution_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Marker
      Name: Voxblox surface
      Enabled: true
      Topic:
        Value: /surface_mesh
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Surface points
      Enabled: false
      Topic:
        Value: /surface_pointcloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Squares
      Size (m): 0.05
      Position Transformer: XYZ
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: TSDF distances
      Enabled: false
      Topic:
        Value: /tsdf_pointcloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Squares
      Size (m): 0.05
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF distances
      Enabled: false
      Topic:
        Value: /esdf_pointcloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Squares
      Size (m): 0.05
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
    - Class: rviz_default_plugins/MarkerArray
      Name: TSDF occupied voxels
      Enabled: false
      Topic:
        Value: /occupied_nodes
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: TSDF slice
      Enabled: false
      Topic:
        Value: /tsdf_slice
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Squares
      Size (m): 0.05
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF slice
      Enabled: false
      Topic:
        Value: /esdf_slice
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Squares
      Size (m): 0.05
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
    - Class: rviz_default_plugins/PointCloud2
      Name: Traversable voxels
      Enabled: false
      Topic:
        Value: /traversable
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Squares
      Size (m): 0.05
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.85
      Yaw: 0.6
      Name: Current View
Window Geometry:
  Width: 1280
  Height: 800
